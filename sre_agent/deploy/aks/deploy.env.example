# Turnkey deploy values for apply.sh. Copy to deploy.env and fill in.
#   cp deploy.env.example deploy.env && $EDITOR deploy.env
# deploy.env is gitignored — it holds identifiers, not secrets (the actual
# secrets live in Key Vault; see README step 2).

# --- Container image (built + pushed per README step 1) ---
ACR_LOGIN_SERVER="myregistry.azurecr.io"
IMAGE_TAG="1.0.0"                     # maps to <TAG>

# --- Workload Identity (README serviceaccount setup) ---
MANAGED_IDENTITY_CLIENT_ID="00000000-0000-0000-0000-000000000000"

# --- Key Vault holding the secrets (README step 2) ---
KEYVAULT_NAME="kv-sre-agent"
TENANT_ID="11111111-1111-1111-1111-111111111111"

# --- Public hostname served by the ingress / oauth2-proxy redirect ---
HOST="sre-console.example.com"

# --- Azure OpenAI resource name (endpoint is https://<name>.openai.azure.com) ---
AOAI_RESOURCE="aoai-sre-agent-prod"

# --- Optional: in-app JWT signature verification (defense-in-depth) ---
# Only needed if you set SRE_AGENT_WEBAPI_JWT_VERIFY=true in configmap.yaml.
# API_APP_CLIENT_ID="22222222-2222-2222-2222-222222222222"
